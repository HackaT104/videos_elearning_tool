# ---- Giọng đọc: CIT Voice Studio (phải chạy trên cùng máy với worker) ----
CIT_TTS_BASE_URL=http://127.0.0.1:8001
# Để trống nếu CIT không yêu cầu khóa (khi có sẽ gửi header X-API-Key)
CIT_TTS_API_KEY=
# Giọng mặc định (tên có dấu đúng như trong CIT)
CVS_VOICE_MALE=Hải Đăng
CVS_VOICE_FEMALE=Trúc Ly
# 1 = giọng GIẢ LẬP (chỉ để thử luồng khi chưa có CIT; không dùng cho video thật)
CVS_TTS_MOCK=0
# Python cho Edge TTS dự phòng (pip install edge-tts)
PYTHON=python

# ---- Claude API (bóc cấu trúc, viết kịch bản, thiết kế/soát cảnh) ----
ANTHROPIC_API_KEY=
CVS_CLAUDE_MODEL=claude-opus-5-5

# ---- Worker & render ----
CVS_API_PORT=3001
CVS_WORKER_CONCURRENCY=4
CVS_RENDER_CONCURRENCY=1
# auto = thử `hyperframes render`, lỗi thì dùng render dự phòng (Playwright + ffmpeg); cli | fallback
CVS_HF_RENDERER=auto
CVS_REMOTION_CONCURRENCY=2
# Đường dẫn Chrome tùy chọn (để trống = tự tải khi cài)
CVS_REMOTION_BROWSER=
CVS_CHROMIUM_PATH=
# Thư mục lưu trữ (mặc định ./storage)
CVS_STORAGE=

# ---- Dùng trên điện thoại (cùng mạng Wi-Fi với máy tính) ----
# CVS_LAN=1 mở giao diện cho thiết bị khác; bắt buộc đặt mã PIN
CVS_LAN=0
CVS_ACCESS_PIN=
CVS_WEB_PORT=3000

# ---- CIT Voice Studio (cài và chạy kèm ứng dụng) ----
# 0 = không tự cài (dùng bản CIT bạn đã cài sẵn)
CVS_CIT_AUTO_INSTALL=1
# 0 = không tự khởi động/theo dõi CIT
CVS_CIT_MANAGE=1
CVS_CIT_VERSION=1.0.4

# ---- ZeroTTS (giọng thứ hai, MIT – https://github.com/zeroweight-ai/ZeroTTS) ----
# Mặc định chỉ cài khi bấm "Cài ZeroTTS" trên trang Giọng đọc (tải mô hình ~300–900 MB). 1 = tự cài khi khởi động / cai-dat
CVS_ZEROTTS_AUTO_INSTALL=0
# 0 = không tự chạy/theo dõi máy chủ ZeroTTS (đã cài thì mặc định tự chạy cùng worker)
CVS_ZEROTTS_MANAGE=1
# 1 = dựng bản int8 khi cài (nhanh hơn trên CPU thường; cần pip onnx); 0 = dùng bản fp32
CVS_ZEROTTS_INT8=1
# Máy chủ cục bộ (chỉ 127.0.0.1)
CVS_ZEROTTS_PORT=8002
CVS_ZEROTTS_URL=http://127.0.0.1:8002
# Python ≥ 3.10 để tạo venv (trống = py -3 / python3 / python)
CVS_ZEROTTS_PYTHON=
